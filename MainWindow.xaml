<Window x:Class="XboxBatteryMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tb="http://www.hardcodet.net/taskbar" xmlns:local="clr-namespace:XboxBatteryMonitor" Title="X-Charge" Width="260" SizeToContent="Height" MinHeight="38" MinWidth="38" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" KeyDown="Window_KeyDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:PercentToWidthConverter x:Key="PercentToWidthConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <tb:TaskbarIcon Name="TrayIcon" ToolTipText="X-Charge" MenuActivation="RightClick" TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
      <FrameworkElement.ContextMenu>
        <ContextMenu Name="TrayMenu">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="4,4,4,4" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                      <Border BorderBrush="#383838" BorderThickness="0,1,0,0" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
              <Style x:Key="{x:Type ContextMenu}" TargetType="{x:Type ContextMenu}">
                <Setter Property="Background" Value="#252525" />
                <Setter Property="Foreground" Value="#E0E0E0" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                      <Border Background="{TemplateBinding Control.Background}" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Margin="0,0,8,8">
                        <UIElement.Effect>
                          <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.5" />
                        </UIElement.Effect>
                        <ItemsPresenter Margin="0,4" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
              <Style x:Key="{x:Type MenuItem}" TargetType="{x:Type MenuItem}">
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="Foreground" Value="#E0E0E0" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                      <Border Name="Bd" Padding="12,6,12,6" Background="{TemplateBinding Control.Background}" CornerRadius="5" Margin="4,1,4,1" SnapsToDevicePixels="True">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" SharedSizeGroup="Checkmark" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                            <ColumnDefinition Width="16" />
                          </Grid.ColumnDefinitions>
                          <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center" />
                          <TextBlock Name="CheckGlyph" Text="✓" Visibility="Collapsed" Foreground="#38BDF8" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" />
                          <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="4,0,16,0" />
                          <Path Name="Arrow" Grid.Column="3" Data="M0,0 L4,4 L0,8" Fill="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed" />
                          <Popup Name="PART_Popup" AllowsTransparency="True" Placement="Right" Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="#252525" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Margin="0,0,8,8">
                              <UIElement.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.5" />
                              </UIElement.Effect>
                              <ItemsPresenter Margin="0,4" />
                            </Border>
                          </Popup>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="MenuItem.IsHighlighted" Value="True">
                          <Setter TargetName="Bd" Property="Border.Background" Value="#0078D7" />
                          <Setter Property="Foreground" Value="#FFFFFFFF" />
                          <Setter TargetName="CheckGlyph" Property="TextBlock.Foreground" Value="#FFFFFFFF" />
                          <Setter TargetName="Arrow" Property="Shape.Fill" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="MenuItem.IsChecked" Value="True">
                          <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ItemsControl.HasItems" Value="True">
                          <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter Property="Foreground" Value="#666666" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <MenuItem Name="ToggleWindowItem" Header="Mostrar" Click="ToggleWindowItem_Click" />
          <Separator />
          <MenuItem Name="ThemesMenuItem" Header="Temas">
            <MenuItem Name="DarkThemeItem" Header="Oscuro" Tag="0" IsCheckable="True" Click="ThemeItem_Click" />
            <MenuItem Name="LightThemeItem" Header="Claro" Tag="1" IsCheckable="True" Click="ThemeItem_Click" />
            <MenuItem Name="TransparentThemeItem" Header="Transparente" Tag="2" IsCheckable="True" Click="ThemeItem_Click" />
          </MenuItem>
          <MenuItem Name="SoundsMenuItem" Header="Sonidos y Alertas">
            <MenuItem Name="ThresholdMenuItem" Header="Nivel de Alarma">
              <MenuItem Name="Th10Item" Header="10%" IsCheckable="True" Tag="10" Click="ThresholdItem_Click" />
              <MenuItem Name="Th15Item" Header="15%" IsCheckable="True" Tag="15" Click="ThresholdItem_Click" />
              <MenuItem Name="Th20Item" Header="20%" IsCheckable="True" Tag="20" Click="ThresholdItem_Click" />
            </MenuItem>
            <Separator />
            <MenuItem Name="UsbSoundItem" Header="Al conectar y desconectar USB" IsCheckable="True" Click="UsbSoundItem_Click" />
            <MenuItem Name="BatterySoundItem" Header="Alerta de bateria" IsCheckable="True" Click="BatterySoundItem_Click" />
          </MenuItem>
          <MenuItem Name="SettingsMenuItem" Header="Configuración">
            <MenuItem Name="GhostModeItem" Header="Modo fantasma (clics atraviesan)" IsCheckable="True" Click="GhostModeItem_Click" />
            <MenuItem Name="HotKeyItem" Header="Atajo global (Ctrl+Shift+X)" IsCheckable="True" Click="HotKeyItem_Click" />
            <MenuItem Name="HideUntilLowItem" Header="Ocultar hasta batería baja" IsCheckable="True" Click="HideUntilLowItem_Click" />
            <Separator />
            <MenuItem Name="StartupItem" Header="Iniciar con Windows" IsCheckable="True" Click="StartupItem_Click" />
            <MenuItem Name="StartInTrayItem" Header="Iniciar en bandeja del sistema" IsCheckable="True" Click="StartInTrayItem_Click" />
            <Separator />
            <MenuItem Name="PollIntervalMenuItem" Header="Frecuencia de sondeo">
              <MenuItem Name="Poll1sItem" Header="1 segundo (Juegos)" IsCheckable="True" Tag="1" Click="PollIntervalItem_Click" />
              <MenuItem Name="Poll2sItem" Header="2 segundos" IsCheckable="True" Tag="2" Click="PollIntervalItem_Click" />
              <MenuItem Name="Poll3sItem" Header="3 segundos (Recomendado)" IsCheckable="True" Tag="3" Click="PollIntervalItem_Click" />
              <MenuItem Name="Poll5sItem" Header="5 segundos (Ahorro)" IsCheckable="True" Tag="5" Click="PollIntervalItem_Click" />
            </MenuItem>
          </MenuItem>
          <MenuItem Name="LanguagesMenuItem" Header="Idioma">
            <MenuItem Name="LangEnItem" Header="English" Tag="en" IsCheckable="True" Click="LanguageItem_Click" />
            <MenuItem Name="LangEsItem" Header="Español" Tag="es" IsCheckable="True" Click="LanguageItem_Click" />
            <MenuItem Name="LangFrItem" Header="Français" Tag="fr" IsCheckable="True" Click="LanguageItem_Click" />
            <MenuItem Name="LangDeItem" Header="Deutsch" Tag="de" IsCheckable="True" Click="LanguageItem_Click" />
            <MenuItem Name="LangPtItem" Header="Português" Tag="pt" IsCheckable="True" Click="LanguageItem_Click" />
            <MenuItem Name="LangZhItem" Header="中文" Tag="zh" IsCheckable="True" Click="LanguageItem_Click" />
            <MenuItem Name="LangRuItem" Header="Русский" Tag="ru" IsCheckable="True" Click="LanguageItem_Click" />
          </MenuItem>
          <Separator />
          <MenuItem Name="ExitItem" Header="Salir" Click="ExitItem_Click" />
        </ContextMenu>
      </FrameworkElement.ContextMenu>
    </tb:TaskbarIcon>
    <Border Name="FullModeBorder" CornerRadius="10" Padding="12" BorderBrush="#404040" BorderThickness="1" Background="#E6202020" Visibility="Visible">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="0,0,0,8">
          <TextBlock Name="TitleText" Text="Controles" FontSize="13" Foreground="#CCCCCC" HorizontalAlignment="Left" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="CompactButton" Content="◱" Width="20" Height="20" Background="#00FFFFFF" BorderThickness="0" Foreground="#AAAAAA" Cursor="Hand" ToolTip="Modo compacto" Margin="0,0,4,0" FontSize="14" VerticalContentAlignment="Center" Click="ToggleMode_Click" />
            <Button Name="MinimizeButton" Content="—" Width="20" Height="20" Background="#00FFFFFF" BorderThickness="0" Foreground="#AAAAAA" Cursor="Hand" ToolTip="Minimizar a bandeja" Margin="0,0,4,0" FontSize="10" VerticalContentAlignment="Center" Click="MinimizeButton_Click" />
            <Button Name="CloseButton" Content="✕" Width="20" Height="20" Background="#00FFFFFF" BorderThickness="0" Foreground="#AAAAAA" Cursor="Hand" ToolTip="Minimizar a bandeja" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Controllers, RelativeSource={RelativeSource AncestorType=Window}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,4" Text="{Binding Name}" />
                <Grid Grid.Row="1" Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="TrackBar" Height="14" CornerRadius="7" Background="{Binding TrackBarBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,0" ClipToBounds="True">
                    <Border HorizontalAlignment="Left" CornerRadius="7" Height="14" Background="{Binding BatteryColor}">
                      <Border.Width>
                        <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                          <Binding Path="Percent" />
                          <Binding Path="ActualWidth" ElementName="TrackBar" />
                        </MultiBinding>
                      </Border.Width>
                    </Border>
                  </Border>
                  <TextBlock Grid.Column="1" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Text="{Binding DisplayPercentText}" />
                </Grid>
                <TextBlock Grid.Row="2" FontSize="11" Foreground="{Binding SubtitleBrush, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding StatusText}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Name="StatusText" Grid.Row="2" Text="" FontSize="11" Foreground="{Binding SubtitleBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,4,0,0" Visibility="Collapsed" />
      </Grid>
    </Border>
    <Border Name="CompactModeBorder" CornerRadius="999" BorderBrush="#404040" BorderThickness="1" Background="#E6202020" Visibility="Collapsed" ClipToBounds="True" ToolTip="Gira la rueda del ratón para regular opacidad" PreviewMouseWheel="CompactMode_PreviewMouseWheel">
      <Grid>
        <Border Name="ShineOverlay" Width="60" Height="400" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00FFFFFF" Offset="0" />
              <GradientStop Color="#80FFFFFF" Offset="0.5" />
              <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <UIElement.RenderTransform>
            <TransformGroup>
              <SkewTransform AngleX="-25" />
              <TranslateTransform x:Name="ShineTransform" X="-150" />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Border>
        <TextBlock Name="CompactPercentText" Text="--%" FontSize="24" FontWeight="SemiBold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
          <UIElement.RenderTransform>
            <TranslateTransform x:Name="TextShiftTransform" X="0" Y="0" />
          </UIElement.RenderTransform>
        </TextBlock>
        <!-- Medidor de Opacidad Interactivo (Rueda del ratón) -->
        <Grid Name="OpacityMeterOverlay" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Background="#D9111827" CornerRadius="8" Padding="7,4" BorderBrush="#4038BDF8" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="M12,4.5 C7,4.5 2.73,7.61 1,12 C2.73,16.39 7,19.5 12,19.5 C17,19.5 21.27,16.39 23,12 C21.27,7.61 17,4.5 12,4.5 Z M12,17 C9.24,17 7,14.76 7,12 C7,9.24 9.24,7 12,7 C14.76,7 17,9.24 17,12 C17,14.76 14.76,17 12,17 Z M12,9 C10.34,9 9,10.34 9,12 C9,13.66 10.34,15 12,15 C13.66,15 15,13.66 15,12 C15,10.34 13.66,9 12,9 Z" 
                      Fill="#38BDF8" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Name="OpacityMeterText" Text="85%" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
              </StackPanel>
              <ProgressBar Name="OpacityMeterBar" Width="40" Height="3" Minimum="15" Maximum="100" Value="85" 
                           Background="#26FFFFFF" Foreground="#38BDF8" BorderThickness="0" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
        </Grid>
        <!-- Indicadores superiores centrados: Modo Fantasma, Slot Badge, Selector de Color y Modo Normal -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" IsHitTestVisible="True">
          <Path Name="GhostIndicator" Visibility="Collapsed" IsHitTestVisible="False"
                Data="M12,2A7,7 0 0,0 5,9C5,11.38 6.19,13.47 8,14.74V17A1,1 0 0,0 9,18H15A1,1 0 0,0 16,17V14.74C17.81,13.47 19,11.38 19,9A7,7 0 0,0 12,2M9,21A1,1 0 0,0 10,22H14A1,1 0 0,0 15,21V20H9V21Z"
                Fill="#8038BDF8" Width="10" Height="10" Stretch="Uniform" Margin="0,0,3,0" VerticalAlignment="Center" />
          <Border Name="CompactSlotBadge" CornerRadius="3" Background="#802563EB" Padding="3,1" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,3,0">
            <TextBlock Name="CompactSlotBadgeText" Text="P1" FontSize="9" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
          </Border>
          <Button Name="ColorPickerButton" Width="13" Height="13" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ColorPickerButton_Click" ToolTip="Color del texto" Margin="0,0,3,0" Visibility="Collapsed" VerticalAlignment="Center">
             <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22C13.1,22 14,21.1 14,20C14,19.5 13.8,19 13.5,18.6C13.2,18.2 13,17.7 13,17.2C13,16.1 13.9,15.2 15,15.2H17C19.8,15.2 22,13 22,10.2C22,5.7 17.5,2 12,2M6.5,12C5.7,12 5,11.3 5,10.5C5,9.7 5.7,9 6.5,9C7.3,9 8,9.7 8,10.5C8,11.3 7.3,12 6.5,12M9.5,8C8.7,8 8,7.3 8,6.5C8,5.7 8.7,5 9.5,5C10.3,5 11,5.7 11,6.5C11,7.3 10.3,8 9.5,8M14.5,8C13.7,8 13,7.3 13,6.5C13,5.7 13.7,5 14.5,5C15.3,5 16,5.7 16,6.5C16,7.3 15.3,8 14.5,8M17.5,12C16.7,12 16,11.3 16,10.5C16,9.7 16.7,9 17.5,9C18.3,9 19,9.7 19,10.5C19,11.3 18.3,12 17.5,12Z" Fill="#CCFFFFFF" Stretch="Uniform" />
             <Button.ContextMenu>
                <ContextMenu Name="ColorContextMenu" />
             </Button.ContextMenu>
          </Button>
          <Button Name="FullModeButton" Content="◲" Width="13" Height="13" Background="#00FFFFFF" BorderThickness="0" Foreground="#AAAAAA" Cursor="Hand" ToolTip="Modo normal" FontSize="10" Click="ToggleMode_Click" Visibility="Collapsed" VerticalAlignment="Center" Padding="0" />
        </StackPanel>
        <Thumb Name="ResizeThumb" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta" Visibility="Collapsed" Margin="0,0,6,6">
          <Control.Template>
            <ControlTemplate>
              <Grid Background="#00FFFFFF">
                <Path Data="M8,12 L12,8 M5,12 L12,5 M2,12 L12,2" Stroke="#888888" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
              </Grid>
            </ControlTemplate>
          </Control.Template>
        </Thumb>
      </Grid>
    </Border>
  </Grid>
</Window>