<Window x:Class="XboxBatteryMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tb="http://www.hardcodet.net/taskbar" xmlns:local="clr-namespace:XboxBatteryMonitor" Title="X-Charge" Width="260" SizeToContent="Height" MinHeight="60" MinWidth="60" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False" MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:PercentToWidthConverter x:Key="PercentToWidthConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <tb:TaskbarIcon Name="TrayIcon" ToolTipText="X-Charge" MenuActivation="RightClick" TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
      <FrameworkElement.ContextMenu>
        <ContextMenu Name="TrayMenu">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0,4,0,4" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                      <Border BorderBrush="#404040" BorderThickness="0,1,0,0" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
              <Style x:Key="{x:Type ContextMenu}" TargetType="{x:Type ContextMenu}">
                <Setter Property="Background" Value="#2B2B2B" />
                <Setter Property="Foreground" Value="#E0E0E0" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                      <Border Background="{TemplateBinding Control.Background}" BorderBrush="#151515" BorderThickness="1" CornerRadius="6" Margin="0,0,8,8">
                        <UIElement.Effect>
                          <DropShadowEffect BlurRadius="6" ShadowDepth="3" Opacity="0.4" />
                        </UIElement.Effect>
                        <ItemsPresenter Margin="0,4" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
              <Style x:Key="{x:Type MenuItem}" TargetType="{x:Type MenuItem}">
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="Foreground" Value="#E0E0E0" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                      <Border Name="Bd" Padding="12,6,12,6" Background="{TemplateBinding Control.Background}" CornerRadius="4" Margin="4,1,4,1" SnapsToDevicePixels="True">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" SharedSizeGroup="Checkmark" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                            <ColumnDefinition Width="16" />
                          </Grid.ColumnDefinitions>
                          <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center" />
                          <TextBlock Name="CheckGlyph" Text="✓" Visibility="Collapsed" Foreground="#E0E0E0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" />
                          <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="4,0,16,0" />
                          <Path Name="Arrow" Grid.Column="3" Data="M0,0 L4,4 L0,8" Fill="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed" />
                          <Popup Name="PART_Popup" AllowsTransparency="True" Placement="Right" Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="#2B2B2B" BorderBrush="#151515" BorderThickness="1" CornerRadius="6" Margin="0,0,8,8">
                              <UIElement.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="3" Opacity="0.4" />
                              </UIElement.Effect>
                              <ItemsPresenter Margin="0,4" />
                            </Border>
                          </Popup>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="MenuItem.IsHighlighted" Value="True">
                          <Setter TargetName="Bd" Property="Border.Background" Value="#0078D7" />
                          <Setter Property="Foreground" Value="#FFFFFFFF" />
                          <Setter TargetName="CheckGlyph" Property="TextBlock.Foreground" Value="#FFFFFFFF" />
                          <Setter TargetName="Arrow" Property="Shape.Fill" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="MenuItem.IsChecked" Value="True">
                          <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ItemsControl.HasItems" Value="True">
                          <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter Property="Foreground" Value="#666666" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <MenuItem Name="ToggleWindowItem" Header="Mostrar" Click="ToggleWindowItem_Click" />
          <MenuItem Name="ThemesMenuItem" Header="Temas">
            <MenuItem Name="DarkThemeItem" Header="Oscuro" Tag="0" Click="ThemeItem_Click" />
            <MenuItem Name="LightThemeItem" Header="Claro" Tag="1" Click="ThemeItem_Click" />
            <MenuItem Name="TransparentThemeItem" Header="Transparente" Tag="2" Click="ThemeItem_Click" />
          </MenuItem>
          <MenuItem Name="SoundsMenuItem" Header="Sonidos">
            <MenuItem Name="UsbSoundItem" Header="Al conectar y desconectar USB" IsCheckable="True" Click="UsbSoundItem_Click" />
            <MenuItem Name="BatterySoundItem" Header="Alerta de bateria" IsCheckable="True" Click="BatterySoundItem_Click" />
          </MenuItem>
          <MenuItem Name="ThresholdMenuItem" Header="Opciones de Batería">
            <MenuItem Name="Th10Item" Header="10%" IsCheckable="True" Tag="10" Click="ThresholdItem_Click" />
            <MenuItem Name="Th15Item" Header="15%" IsCheckable="True" Tag="15" Click="ThresholdItem_Click" />
            <MenuItem Name="Th20Item" Header="20%" IsCheckable="True" Tag="20" Click="ThresholdItem_Click" />
          </MenuItem>
          <MenuItem Name="StartupItem" Header="Iniciar con Windows" IsCheckable="True" Click="StartupItem_Click" />
          <MenuItem Name="StartInTrayItem" Header="Iniciar en bandeja del sistema" IsCheckable="True" Click="StartInTrayItem_Click" />
          <MenuItem Name="HideUntilLowItem" Header="Ocultar hasta batería baja" IsCheckable="True" Click="HideUntilLowItem_Click" />
          <Separator />
          <MenuItem Name="ExitItem" Header="Salir" Click="ExitItem_Click" />
        </ContextMenu>
      </FrameworkElement.ContextMenu>
    </tb:TaskbarIcon>
    <Border Name="FullModeBorder" CornerRadius="10" Padding="12" BorderBrush="#404040" BorderThickness="1" Background="#E6202020" Visibility="Visible">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="0,0,0,8">
          <TextBlock Name="TitleText" Text="Controles" FontSize="13" Foreground="#CCCCCC" HorizontalAlignment="Left" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="CompactButton" Content="◱" Width="20" Height="20" Background="#00FFFFFF" BorderThickness="0" Foreground="#AAAAAA" Cursor="Hand" ToolTip="Modo compacto" Margin="0,0,4,0" FontSize="14" VerticalContentAlignment="Center" Click="ToggleMode_Click" />
            <Button Name="MinimizeButton" Content="—" Width="20" Height="20" Background="#00FFFFFF" BorderThickness="0" Foreground="#AAAAAA" Cursor="Hand" ToolTip="Minimizar a bandeja" Margin="0,0,4,0" FontSize="10" VerticalContentAlignment="Center" Click="MinimizeButton_Click" />
            <Button Name="CloseButton" Content="✕" Width="20" Height="20" Background="#00FFFFFF" BorderThickness="0" Foreground="#AAAAAA" Cursor="Hand" ToolTip="Minimizar a bandeja" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Controllers, RelativeSource={RelativeSource AncestorType=Window}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontSize="12" Foreground="#DDDDDD" Margin="0,0,0,4" Text="{Binding Name}" />
                <Grid Grid.Row="1" Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Height="14" CornerRadius="7" Background="#333333" Margin="0,0,8,0">
                    <Border HorizontalAlignment="Left" CornerRadius="7" Height="14" Background="{Binding BatteryColor}" Width="{Binding Path=Percent, Converter={StaticResource PercentToWidthConverter}}" />
                  </Border>
                  <TextBlock Grid.Column="1" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center" Text="{Binding DisplayPercentText}" />
                </Grid>
                <TextBlock Grid.Row="2" FontSize="11" Foreground="#999999" Text="{Binding StatusText}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Name="StatusText" Grid.Row="2" Text="" FontSize="11" Foreground="#999999" Margin="0,4,0,0" Visibility="Collapsed" />
      </Grid>
    </Border>
    <Border Name="CompactModeBorder" CornerRadius="10" BorderBrush="#404040" BorderThickness="1" Background="#E6202020" Visibility="Collapsed" ClipToBounds="True" ToolTip="Doble clic para probar efecto anti-quemado" MouseDown="CompactMode_MouseDown">
      <Grid>
        <Border Name="ShineOverlay" Width="60" Height="400" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00FFFFFF" Offset="0" />
              <GradientStop Color="#80FFFFFF" Offset="0.5" />
              <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <UIElement.RenderTransform>
            <TransformGroup>
              <SkewTransform AngleX="-25" />
              <TranslateTransform x:Name="ShineTransform" X="-150" />
            </TransformGroup>
          </UIElement.RenderTransform>
        </Border>
        <TextBlock Name="CompactPercentText" Text="--%" FontSize="24" FontWeight="SemiBold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
          <UIElement.RenderTransform>
            <TranslateTransform x:Name="TextShiftTransform" X="0" Y="0" />
          </UIElement.RenderTransform>
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
          <Button Name="FullModeButton" Content="◲" Width="16" Height="16" Background="#00FFFFFF" BorderThickness="0" Foreground="#AAAAAA" Cursor="Hand" ToolTip="Modo normal" FontSize="12" Click="ToggleMode_Click" />
        </StackPanel>
        <Thumb Name="ResizeThumb" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
          <Control.Template>
            <ControlTemplate>
              <Grid Background="#00FFFFFF">
                <Path Data="M10,14 L14,10 M6,14 L14,6 M2,14 L14,2" Stroke="#888888" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" />
              </Grid>
            </ControlTemplate>
          </Control.Template>
        </Thumb>
      </Grid>
    </Border>
  </Grid>
</Window>